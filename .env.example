# Set these in Vercel (Preview + Production) AND in local .env for development.
# Use a brand new Supabase project that YOU own, not the former Lovable Cloud project.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_SUPABASE_PUBLISHABLE_KEY
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# SECRET server-only: never prefix OPENAI_API_KEY with VITE_.
OPENAI_API_KEY=ADD_IN_VERCEL_SECRET_SETTINGS
OPENAI_MODEL=gpt-5-mini
